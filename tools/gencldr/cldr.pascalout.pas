{ cldr.pascalout - writes the generated Pascal units: one per locale
  (babel.cldr_<locale>), one with the global data (babel.cldr_global) and
  one that uses every generated locale (babel.cldr_all).

  The locale identifier is part of a single identifier after "babel."
  because some language codes alone are Pascal reserved words (as, is, or,
  to). The text of the units is the same as tools/cldrgen/pascal.py
  writes, byte for byte. }
unit cldr.pascalout;

{$mode objfpc}{$H+}

interface

uses
  SysUtils, Classes;

function UnitName(const Locale: string): string;
function FileName(const AUnit: string): string;
function WriteLocaleUnit(const OutDir, CldrVersion, Locale, Parent: string;
  const Blob: TBytes): string;
function WriteGlobalUnit(const OutDir, CldrVersion: string; const Blob: TBytes): string;
function WriteAllUnit(const OutDir, CldrVersion: string; const Units: TStringArray): string;

implementation

function UnitName(const Locale: string): string;
begin
  Result := 'babel.cldr_' + Locale;
end;

function FileName(const AUnit: string): string;
begin
  Result := LowerCase(AUnit) + '.pas';
end;

function Header(const AUnit, Cldr, What, Extra: string): string;
begin
  Result := '{ ' + AUnit + ' - CLDR ' + Cldr + ' data' + What + '.'#10 +
    #10 +
    '  Generated by tools/gencldr.py from the CLDR XML release'#10 +
    '  (cldr-common-' + Cldr + '.zip, Unicode License v3: LICENSE-CLDR). Do not edit.'#10 +
    Extra + '}'#10;
end;

var
  ByteText: array[Byte] of string;

{ The data as a typed constant, 32 bytes per line. }
function BytesConst(const Name: string; const Blob: TBytes): string;
var
  SB: TStringBuilder;
  J: Integer;
begin
  SB := TStringBuilder.Create(Length(Blob) * 4 + 256);
  try
    SB.Append('  ' + Name + ': array[0..' + IntToStr(Length(Blob) - 1) + '] of Byte = (');
    for J := 0 to High(Blob) do
    begin
      if J mod 32 = 0 then
        SB.Append(#10'    ')
      else
        SB.Append(',');
      SB.Append(ByteText[Blob[J]]);
      if (J mod 32 = 31) and (J < High(Blob)) then
        SB.Append(',');
    end;
    SB.Append(#10'  );');
    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

procedure WriteText(const OutDir, AUnit, Text: string);
var
  F: TFileStream;
begin
  F := TFileStream.Create(IncludeTrailingPathDelimiter(OutDir) + FileName(AUnit), fmCreate);
  try
    if Length(Text) > 0 then
      F.WriteBuffer(Text[1], Length(Text));
  finally
    F.Free;
  end;
end;

function WriteLocaleUnit(const OutDir, CldrVersion, Locale, Parent: string;
  const Blob: TBytes): string;
var
  Uses_, Extra, Text: string;
begin
  Result := UnitName(Locale);
  Uses_ := 'babel.localedata';
  if Parent <> '' then
  begin
    Uses_ := Uses_ + ', ' + UnitName(Parent);
    // no period and no line end after the parenthesis (as pascal.py writes)
    Extra := #10'  A program that uses this unit can format for the locale "' + Locale +
      '"'#10'  and every locale it inherits from (this unit uses ' + UnitName(Parent) + ')';
  end
  else
    Extra := '.'#10;
  Text := Header(Result, CldrVersion, ' for the locale "' + Locale + '"', Extra) +
    'unit ' + Result + ';'#10 +
    #10 +
    '{$mode objfpc}{$H+}'#10 +
    #10 +
    'interface'#10 +
    #10 +
    'implementation'#10 +
    #10 +
    'uses'#10 +
    '  ' + Uses_ + ';'#10 +
    #10 +
    'const'#10 +
    BytesConst('Data', Blob) + #10 +
    #10 +
    'initialization'#10 +
    '  RegisterLocaleData(''' + Locale + ''', ''' + Parent + ''', @Data[0], Length(Data));'#10 +
    'end.'#10;
  WriteText(OutDir, Result, Text);
end;

function WriteGlobalUnit(const OutDir, CldrVersion: string; const Blob: TBytes): string;
var
  Text: string;
begin
  Result := 'babel.cldr_global';
  Text := Header(Result, CldrVersion, ' that is not per locale',
    #10'  Likely subtags, aliases, parent locales, currencies of territories,'#10 +
    '  time zone mappings.'#10) +
    'unit ' + Result + ';'#10 +
    #10 +
    '{$mode objfpc}{$H+}'#10 +
    #10 +
    'interface'#10 +
    #10 +
    'implementation'#10 +
    #10 +
    'uses'#10 +
    '  babel.localedata;'#10 +
    #10 +
    'const'#10 +
    BytesConst('Data', Blob) + #10 +
    #10 +
    'initialization'#10 +
    '  RegisterGlobalData(@Data[0], Length(Data));'#10 +
    'end.'#10;
  WriteText(OutDir, Result, Text);
end;

function WriteAllUnit(const OutDir, CldrVersion: string; const Units: TStringArray): string;
var
  Text: string;
  J: Integer;
begin
  Result := 'babel.cldr_all';
  Text := Header(Result, CldrVersion, ': every generated locale',
    #10'  Uses the ' + IntToStr(Length(Units)) + ' locale units, so a program that uses this'#10 +
    '  unit can format for any of them.'#10) +
    'unit ' + Result + ';'#10 +
    #10 +
    '{$mode objfpc}{$H+}'#10 +
    #10 +
    'interface'#10 +
    #10 +
    'uses'#10;
  for J := 0 to High(Units) do
  begin
    Text := Text + '  ' + Units[J];
    if J < High(Units) then
      Text := Text + ','#10;
  end;
  Text := Text + ';'#10 +
    #10 +
    'implementation'#10 +
    #10 +
    'end.'#10;
  WriteText(OutDir, Result, Text);
end;

var
  B: Byte;

initialization
  for B := Low(Byte) to High(Byte) do
    ByteText[B] := IntToStr(B);

end.
