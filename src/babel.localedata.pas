{ babel.localedata - the CLDR data of each locale, loaded on first use.

  The data comes from the babel.cldr_* units (src/data/, generated by
  tools/gencldr.py from the CLDR XML release). Each such unit holds the
  encoded data of one locale (babel.cldr_es_PE for es_PE) and registers it
  here in its initialization section, so a program has the data of
  exactly the locales whose units it uses (babel.cldr_all uses every
  generated locale; babel.cldr_global holds the data that is not per
  locale). Each locale unit uses
  the unit of the locale it inherits from, so the chain up to root is
  always present.

  The data of a locale is a tree of TCLDRValue: maps, lists, strings and
  numbers, with the keys of tools/cldrgen/importer.py (number and date
  patterns are strings; plural rules are lists of [category,
  condition]). LoadLocaleData merges the locale's own data into a copy of
  its parent's, map by map, and resolves aliases, so the result holds
  everything the locale inherits.

  Ownership: every TCLDRValue belongs to this unit and lives until the
  program ends; callers never free one.

  Threading: registration happens in initialization sections (one
  thread). After that the registry does not change; LoadLocaleData builds
  each locale's tree once, under a lock, and every thread may read the
  trees, which never change. }
unit babel.localedata;

{$mode objfpc}{$H+}

interface

uses
  SysUtils;

type
  ELocaleDataError = class(Exception);

  TCLDRKind = (ckNone, ckBool, ckInt, ckFloat, ckString, ckList, ckMap,
    ckAlias, ckAliasMerge);

  { One value of the data: None, a boolean, an integer, a float, a string
    (UTF-8), a list or a map (keys None, integers or strings, in insertion
    order). ckAlias and ckAliasMerge occur only in data loaded with
    MergeInherited = False. }
  TCLDRValue = class
  private
    FKind: TCLDRKind;
    FInt: Int64;
    FFloat: Double;
    FStr: string;
    FKeys: array of TCLDRValue;   { map keys }
    FItems: array of TCLDRValue;  { list items; map values; alias path }
    FOrder: array of Integer;     { map: entry positions sorted by key }
    FOthers: TCLDRValue;          { ckAliasMerge: the map merged over the alias }
    function FindKey(AKind: TCLDRKind; AInt: Int64; const AStr: string): Integer;
    procedure BuildOrder;
  public
    property Kind: TCLDRKind read FKind;
    function IsNone: Boolean;
    function AsBoolean: Boolean;
    function AsInteger: Int64;
    function AsFloat: Double;
    function AsString: string;
    { Lists: the number of items; maps: the number of entries. }
    function Count: Integer;
    { Lists: item I; maps: the value of entry I (0-based, insertion order). }
    function Items(I: Integer): TCLDRValue;
    { Maps: the key of entry I. }
    function Keys(I: Integer): TCLDRValue;
    { Maps: the value under the key; nil when absent (or not a map). }
    function Get(const Key: string): TCLDRValue;
    function GetInt(Key: Int64): TCLDRValue;
    function GetNone: TCLDRValue;
    function Has(const Key: string): Boolean;
    { Follows string keys from this map; nil when one is absent. }
    function Path(const KeyPath: array of string): TCLDRValue;
    { The string under Key, or Default when absent or not a string. }
    function Str(const Key: string; const Default: string = ''): string;
    { The alias path (ckAlias, ckAliasMerge). }
    function AliasKeys: TStringArray;
  end;

{ Called by the generated units. Data must stay valid for the whole run
  (a constant). Parent is '' for root. }
procedure RegisterLocaleData(const Name, Parent: string; Data: PByte; Len: SizeInt);
procedure RegisterGlobalData(Data: PByte; Len: SizeInt);

{ The version of the CLDR release the linked data comes from ('47'). Raises ELocaleDataError when no global data is
  linked. }
function GetCLDRVersion: string;

{ True when the data of the locale is linked into the program. Exact match
  first; else a case-insensitive match. }
function LocaleDataExists(const Name: string): Boolean;
{ The registered identifier that equals Name ignoring case; '' if none. }
function NormalizeLocale(const Name: string): string;
{ Every registered locale identifier except root, sorted. }
function LocaleIdentifiers: TStringArray;
{ The data of the locale, merged with what it inherits and with aliases
  resolved (MergeInherited = False: the locale's own data only, as
  stored). Raises ELocaleDataError when the locale is not registered. }
function LoadLocaleData(const Name: string; MergeInherited: Boolean = True): TCLDRValue;
{ One map of the global data (likely_subtags, parent_exceptions, cldr, ...); an
  empty map for an unknown key. Raises ELocaleDataError when no global
  data is linked. }
function GetGlobal(const Key: string): TCLDRValue;
{ A map with no entries (shared; never changes). }
function EmptyCLDRMap: TCLDRValue;

implementation

type
  TLocaleEntry = record
    Name, Parent: string;
    Data: PByte;
    Len: SizeInt;
    Raw: TCLDRValue;      { merged with the parent's Raw; aliases unresolved }
    Merged: TCLDRValue;   { Raw with aliases resolved; published once built }
  end;
  PLocaleEntry = ^TLocaleEntry;

var
  Entries: array of TLocaleEntry;   { sorted by Name }
  EntryCount: Integer;
  GlobalBlob: PByte;
  GlobalLen: SizeInt;
  GlobalTree: TCLDRValue;
  Lock: TRTLCriticalSection;
  Nodes: array of TCLDRValue;       { every node, freed at finalization }
  NodeCount: Integer;
  NoneNode, FalseNode, TrueNode, EmptyMap: TCLDRValue;

function NewNode(AKind: TCLDRKind): TCLDRValue;
begin
  Result := TCLDRValue.Create;
  Result.FKind := AKind;
  if NodeCount = Length(Nodes) then
    SetLength(Nodes, 2 * NodeCount + 1024);
  Nodes[NodeCount] := Result;
  Inc(NodeCount);
end;

{ ---- TCLDRValue ---- }

function KindRank(K: TCLDRKind): Integer; inline;
begin
  case K of
    ckNone: Result := 0;
    ckInt: Result := 1;
  else
    Result := 2;
  end;
end;

function CompareKey(A: TCLDRValue; BKind: TCLDRKind; BInt: Int64; const BStr: string): Integer;
begin
  Result := KindRank(A.FKind) - KindRank(BKind);
  if Result <> 0 then
    Exit;
  case A.FKind of
    ckNone: Result := 0;
    ckInt:
      if A.FInt < BInt then Result := -1
      else if A.FInt > BInt then Result := 1
      else Result := 0;
  else
    Result := CompareStr(A.FStr, BStr);
  end;
end;

procedure TCLDRValue.BuildOrder;
var
  I, J, T: Integer;
  Lo, Hi, Mid: Integer;
begin
  { Binary insertion sort of the positions by key. }
  SetLength(FOrder, Length(FKeys));
  for I := 0 to High(FKeys) do
  begin
    Lo := 0;
    Hi := I;
    while Lo < Hi do
    begin
      Mid := (Lo + Hi) div 2;
      if CompareKey(FKeys[FOrder[Mid]], FKeys[I].FKind, FKeys[I].FInt, FKeys[I].FStr) < 0 then
        Lo := Mid + 1
      else
        Hi := Mid;
    end;
    for J := I downto Lo + 1 do
      FOrder[J] := FOrder[J - 1];
    T := I;
    FOrder[Lo] := T;
  end;
end;

function TCLDRValue.FindKey(AKind: TCLDRKind; AInt: Int64; const AStr: string): Integer;
var
  Lo, Hi, Mid, C: Integer;
begin
  Result := -1;
  if FKind <> ckMap then
    Exit;
  Lo := 0;
  Hi := High(FOrder);
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    C := CompareKey(FKeys[FOrder[Mid]], AKind, AInt, AStr);
    if C = 0 then
      Exit(FOrder[Mid])
    else if C < 0 then
      Lo := Mid + 1
    else
      Hi := Mid - 1;
  end;
end;

function TCLDRValue.IsNone: Boolean;
begin
  Result := FKind = ckNone;
end;

function TCLDRValue.AsBoolean: Boolean;
begin
  Result := (FKind = ckBool) and (FInt <> 0);
end;

function TCLDRValue.AsInteger: Int64;
begin
  if FKind = ckFloat then
    Result := Trunc(FFloat)
  else
    Result := FInt;
end;

function TCLDRValue.AsFloat: Double;
begin
  if FKind = ckInt then
    Result := FInt
  else
    Result := FFloat;
end;

function TCLDRValue.AsString: string;
begin
  Result := FStr;
end;

function TCLDRValue.Count: Integer;
begin
  Result := Length(FItems);
end;

function TCLDRValue.Items(I: Integer): TCLDRValue;
begin
  Result := FItems[I];
end;

function TCLDRValue.Keys(I: Integer): TCLDRValue;
begin
  Result := FKeys[I];
end;

function TCLDRValue.Get(const Key: string): TCLDRValue;
var
  I: Integer;
begin
  if Self = nil then
    Exit(nil);
  I := FindKey(ckString, 0, Key);
  if I < 0 then
    Result := nil
  else
    Result := FItems[I];
end;

function TCLDRValue.GetInt(Key: Int64): TCLDRValue;
var
  I: Integer;
begin
  if Self = nil then
    Exit(nil);
  I := FindKey(ckInt, Key, '');
  if I < 0 then
    Result := nil
  else
    Result := FItems[I];
end;

function TCLDRValue.GetNone: TCLDRValue;
var
  I: Integer;
begin
  if Self = nil then
    Exit(nil);
  I := FindKey(ckNone, 0, '');
  if I < 0 then
    Result := nil
  else
    Result := FItems[I];
end;

function TCLDRValue.Has(const Key: string): Boolean;
begin
  Result := (Self <> nil) and (FindKey(ckString, 0, Key) >= 0);
end;

function TCLDRValue.Path(const KeyPath: array of string): TCLDRValue;
var
  K: string;
begin
  Result := Self;
  for K in KeyPath do
  begin
    if Result = nil then
      Exit;
    Result := Result.Get(K);
  end;
end;

function TCLDRValue.Str(const Key: string; const Default: string): string;
var
  V: TCLDRValue;
begin
  V := Get(Key);
  if (V <> nil) and (V.FKind = ckString) then
    Result := V.FStr
  else
    Result := Default;
end;

function TCLDRValue.AliasKeys: TStringArray;
var
  I: Integer;
begin
  Result := nil;
  if FKind in [ckAlias, ckAliasMerge] then
  begin
    SetLength(Result, Length(FItems));
    for I := 0 to High(FItems) do
      Result[I] := FItems[I].FStr;
  end;
end;

{ ---- decoding (format: tools/cldrgen/encode.py) ---- }

type
  TDecoder = record
    P, Start: PByte;
    Len: SizeInt;
    Strings: array of TCLDRValue;
  end;

procedure Corrupt(const D: TDecoder; const Msg: string);
begin
  raise ELocaleDataError.CreateFmt('corrupt locale data at byte %d: %s',
    [D.P - D.Start, Msg]);
end;

function ReadByte(var D: TDecoder): Byte;
begin
  if D.P - D.Start >= D.Len then
    Corrupt(D, 'unexpected end');
  Result := D.P^;
  Inc(D.P);
end;

function ReadVarint(var D: TDecoder): QWord;
var
  B: Byte;
  Shift: Integer;
begin
  Result := 0;
  Shift := 0;
  repeat
    if Shift > 63 then
      Corrupt(D, 'varint too long');
    B := ReadByte(D);
    Result := Result or (QWord(B and $7F) shl Shift);
    Inc(Shift, 7);
  until B and $80 = 0;
end;

function ReadCount(var D: TDecoder): Integer;
var
  N: QWord;
begin
  N := ReadVarint(D);
  { Every element takes at least one byte. }
  if N > QWord(D.Len - (D.P - D.Start)) then
    Corrupt(D, 'count beyond the end');
  Result := Integer(N);
end;

function ReadStringRef(var D: TDecoder): TCLDRValue;
var
  I: QWord;
begin
  I := ReadVarint(D);
  if I >= QWord(Length(D.Strings)) then
    Corrupt(D, 'string index out of range');
  Result := D.Strings[I];
end;

const
  T_NONE = 0; T_FALSE = 1; T_TRUE = 2; T_INT = 3; T_FLOAT = 4; T_STR = 5;
  T_LIST = 6; T_MAP = 7; T_ALIAS = 8;

function ReadValue(var D: TDecoder): TCLDRValue;
var
  Tag: Byte;
  Z: QWord;
  N, I: Integer;
  F: Double;
begin
  Tag := ReadByte(D);
  case Tag of
    T_NONE: Result := NoneNode;
    T_FALSE: Result := FalseNode;
    T_TRUE: Result := TrueNode;
    T_INT:
      begin
        Z := ReadVarint(D);
        Result := NewNode(ckInt);
        if Z and 1 = 0 then
          Result.FInt := Int64(Z shr 1)
        else
          Result.FInt := -Int64((Z shr 1)) - 1;
      end;
    T_FLOAT:
      begin
        if D.Len - (D.P - D.Start) < 8 then
          Corrupt(D, 'truncated float');
        Move(D.P^, F, 8);
        {$IFDEF ENDIAN_BIG}
        F := SwapEndian(QWord(F));
        {$ENDIF}
        Inc(D.P, 8);
        Result := NewNode(ckFloat);
        Result.FFloat := F;
      end;
    T_STR: Result := ReadStringRef(D);
    T_LIST:
      begin
        N := ReadCount(D);
        Result := NewNode(ckList);
        SetLength(Result.FItems, N);
        for I := 0 to N - 1 do
          Result.FItems[I] := ReadValue(D);
      end;
    T_MAP:
      begin
        N := ReadCount(D);
        Result := NewNode(ckMap);
        SetLength(Result.FKeys, N);
        SetLength(Result.FItems, N);
        for I := 0 to N - 1 do
        begin
          Result.FKeys[I] := ReadValue(D);
          if not (Result.FKeys[I].FKind in [ckNone, ckInt, ckString]) then
            Corrupt(D, 'map key of a bad kind');
          Result.FItems[I] := ReadValue(D);
        end;
        Result.BuildOrder;
      end;
    T_ALIAS:
      begin
        N := ReadCount(D);
        Result := NewNode(ckAlias);
        SetLength(Result.FItems, N);
        for I := 0 to N - 1 do
          Result.FItems[I] := ReadStringRef(D);
      end;
  else
    Corrupt(D, 'unknown tag');
    Result := nil;
  end;
end;

function Decode(Data: PByte; Len: SizeInt): TCLDRValue;
var
  D: TDecoder;
  N, I: Integer;
  SLen: QWord;
  S: string;
begin
  D.P := Data;
  D.Start := Data;
  D.Len := Len;
  if (Len < 5) or (Data[0] <> Ord('B')) or (Data[1] <> Ord('4')) or
     (Data[2] <> Ord('P')) or (Data[3] <> Ord('C')) then
    Corrupt(D, 'bad magic');
  if Data[4] <> 1 then
    Corrupt(D, 'unsupported format version');
  Inc(D.P, 5);
  N := ReadCount(D);
  SetLength(D.Strings, N);
  for I := 0 to N - 1 do
  begin
    SLen := ReadVarint(D);
    if SLen > QWord(D.Len - (D.P - D.Start)) then
      Corrupt(D, 'string beyond the end');
    SetLength(S, SLen);
    if SLen > 0 then
      Move(D.P^, S[1], SLen);
    Inc(D.P, SLen);
    D.Strings[I] := NewNode(ckString);
    D.Strings[I].FStr := S;
  end;
  Result := ReadValue(D);
  if D.P - D.Start <> D.Len then
    Corrupt(D, 'trailing bytes');
  if Result.FKind <> ckMap then
    Corrupt(D, 'top-level value is not a map');
end;

{ ---- merge and alias resolution ---- }

function CopyMap(M: TCLDRValue): TCLDRValue;
begin
  Result := NewNode(ckMap);
  Result.FKeys := Copy(M.FKeys);
  Result.FItems := Copy(M.FItems);
  Result.FOrder := Copy(M.FOrder);
end;

{ Sets Key to Value in the (new, not yet shared) map M: in place when the
  key exists, appended otherwise. }
procedure MapPut(M, Key, Value: TCLDRValue);
var
  I, N: Integer;
begin
  I := M.FindKey(Key.FKind, Key.FInt, Key.FStr);
  if I >= 0 then
  begin
    M.FItems[I] := Value;
    Exit;
  end;
  N := Length(M.FKeys);
  SetLength(M.FKeys, N + 1);
  SetLength(M.FItems, N + 1);
  M.FKeys[N] := Key;
  M.FItems[N] := Value;
  M.BuildOrder;
end;

function MapLookup(M, Key: TCLDRValue): TCLDRValue;
var
  I: Integer;
begin
  I := M.FindKey(Key.FKind, Key.FInt, Key.FStr);
  if I < 0 then
    Result := nil
  else
    Result := M.FItems[I];
end;

function ResolveShallow(V, Base: TCLDRValue): TCLDRValue; forward;

{ Over merged into a fresh copy of Target: None values of Over are
  skipped; a map merges into the map below it (copied); a map
  over an alias makes an alias merge; anything else replaces.

  With Base <> nil the merge goes through the resolved view of the data:
  a value below an incoming map is read resolved, so it is never an
  alias. }
procedure MergeInto(Target, Over: TCLDRValue; Base: TCLDRValue = nil);
var
  I: Integer;
  V1, V2, Merged: TCLDRValue;
begin
  for I := 0 to High(Over.FKeys) do
  begin
    V2 := Over.FItems[I];
    if V2.FKind = ckNone then
      Continue;
    if V2.FKind = ckMap then
    begin
      V1 := MapLookup(Target, Over.FKeys[I]);
      if (V1 <> nil) and (Base <> nil) then
        V1 := ResolveShallow(V1, Base);
      if (V1 = nil) or (V1.FKind = ckNone) then
      begin
        Merged := CopyMap(EmptyMap);
        MergeInto(Merged, V2, Base);
      end
      else if V1.FKind = ckAlias then
      begin
        Merged := NewNode(ckAliasMerge);
        Merged.FItems := V1.FItems;
        Merged.FOthers := V2;
      end
      else if V1.FKind = ckAliasMerge then
      begin
        Merged := NewNode(ckAliasMerge);
        Merged.FItems := V1.FItems;
        Merged.FOthers := CopyMap(V1.FOthers);
        MergeInto(Merged.FOthers, V2);
      end
      else if V1.FKind = ckMap then
      begin
        Merged := CopyMap(V1);
        MergeInto(Merged, V2, Base);
      end
      else
        raise ELocaleDataError.Create('cannot merge a map into a non-map value');
      MapPut(Target, Over.FKeys[I], Merged);
    end
    else
      MapPut(Target, Over.FKeys[I], V2);
  end;
end;

{ Alias resolution. An alias's path is followed through resolved values:
  every container on the path is read in its resolved form. Resolving
  one level at a time (ResolveShallow) keeps an alias inside a map from
  requiring the whole map to be resolved first. }

{ The value at the alias path, each step resolved one level. }
function LookupResolved(Alias, Base: TCLDRValue): TCLDRValue;
var
  I: Integer;
begin
  Result := Base;
  for I := 0 to High(Alias.FItems) do
  begin
    if Result.FKind <> ckMap then
      raise ELocaleDataError.Create('alias path through a non-map value');
    Result := Result.Get(Alias.FItems[I].FStr);
    if Result = nil then
      raise ELocaleDataError.CreateFmt('alias path not found: %s',
        [string.Join('/', Alias.AliasKeys)]);
    Result := ResolveShallow(Result, Base);
  end;
end;

{ An alias: its target; an alias merge: a copy of its target with the
  other values merged in; anything else: itself. The children of the
  result may still be unresolved. }
function ResolveShallow(V, Base: TCLDRValue): TCLDRValue;
var
  Target: TCLDRValue;
begin
  case V.FKind of
    ckAlias:
      Result := LookupResolved(V, Base);
    ckAliasMerge:
      begin
        Target := LookupResolved(V, Base);
        if Target.FKind <> ckMap then
          raise ELocaleDataError.Create('alias merge over a non-map value');
        Result := CopyMap(Target);
        MergeInto(Result, V.FOthers, Base);
      end;
  else
    Result := V;
  end;
end;

{ Every value resolved; maps are copied only where something changed. }
function ResolveAll(V, Base: TCLDRValue): TCLDRValue;
var
  I: Integer;
  R: TCLDRValue;
begin
  Result := ResolveShallow(V, Base);
  if Result.FKind <> ckMap then
    Exit;
  V := Result;
  for I := 0 to High(V.FItems) do
  begin
    R := ResolveAll(V.FItems[I], Base);
    if R <> V.FItems[I] then
    begin
      if Result = V then
        Result := CopyMap(V);
      Result.FItems[I] := R;
    end;
  end;
end;

{ ---- registry ---- }

function FindEntry(const Name: string): PLocaleEntry;
var
  Lo, Hi, Mid, C: Integer;
begin
  Lo := 0;
  Hi := EntryCount - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    C := CompareStr(Entries[Mid].Name, Name);
    if C = 0 then
      Exit(@Entries[Mid])
    else if C < 0 then
      Lo := Mid + 1
    else
      Hi := Mid - 1;
  end;
  Result := nil;
end;

procedure RegisterLocaleData(const Name, Parent: string; Data: PByte; Len: SizeInt);
var
  I: Integer;
begin
  if FindEntry(Name) <> nil then
    Exit;
  if EntryCount = Length(Entries) then
    SetLength(Entries, 2 * EntryCount + 64);
  I := EntryCount;
  while (I > 0) and (CompareStr(Entries[I - 1].Name, Name) > 0) do
  begin
    Entries[I] := Entries[I - 1];
    Dec(I);
  end;
  Entries[I] := Default(TLocaleEntry);
  Entries[I].Name := Name;
  Entries[I].Parent := Parent;
  Entries[I].Data := Data;
  Entries[I].Len := Len;
  Inc(EntryCount);
end;

procedure RegisterGlobalData(Data: PByte; Len: SizeInt);
begin
  GlobalBlob := Data;
  GlobalLen := Len;
end;

function GetCLDRVersion: string;
begin
  Result := GetGlobal('cldr').Str('version');
end;

function NormalizeLocale(const Name: string): string;
var
  I: Integer;
  L: string;
begin
  L := LowerCase(Trim(Name));
  for I := 0 to EntryCount - 1 do
    if LowerCase(Entries[I].Name) = L then
      Exit(Entries[I].Name);
  Result := '';
end;

function LocaleDataExists(const Name: string): Boolean;
begin
  Result := (Name <> '') and ((FindEntry(Name) <> nil) or (NormalizeLocale(Name) <> ''));
end;

function LocaleIdentifiers: TStringArray;
var
  I, N: Integer;
begin
  Result := nil;
  SetLength(Result, EntryCount);
  N := 0;
  for I := 0 to EntryCount - 1 do
    if Entries[I].Name <> 'root' then
    begin
      Result[N] := Entries[I].Name;
      Inc(N);
    end;
  SetLength(Result, N);
end;

{ The locale's data merged into a copy of its parent's merged data, with
  aliases still unresolved (a parent's aliases reach the child
  unresolved, and are resolved against the child's data). Called with
  Lock held. }
function BuildRaw(E: PLocaleEntry): TCLDRValue;
var
  ParentEntry: PLocaleEntry;
  Own: TCLDRValue;
begin
  if E^.Raw <> nil then
    Exit(E^.Raw);
  Result := Decode(E^.Data, E^.Len);
  if E^.Parent <> '' then
  begin
    ParentEntry := FindEntry(E^.Parent);
    if ParentEntry = nil then
      raise ELocaleDataError.CreateFmt('locale %s: parent locale %s is not linked',
        [E^.Name, E^.Parent]);
    Own := Result;
    Result := CopyMap(BuildRaw(ParentEntry));
    MergeInto(Result, Own);
  end;
  E^.Raw := Result;
end;

function LoadLocaleData(const Name: string; MergeInherited: Boolean): TCLDRValue;
var
  E: PLocaleEntry;
  N: string;
begin
  E := FindEntry(Name);
  if E = nil then
  begin
    N := NormalizeLocale(Name);
    if N <> '' then
      E := FindEntry(N);
  end;
  if E = nil then
    raise ELocaleDataError.CreateFmt('no locale data for %s', [Name]);
  if not MergeInherited then
  begin
    EnterCriticalSection(Lock);
    try
      Result := Decode(E^.Data, E^.Len);
    finally
      LeaveCriticalSection(Lock);
    end;
    Exit;
  end;
  Result := E^.Merged;
  ReadBarrier;
  if Result <> nil then
    Exit;
  EnterCriticalSection(Lock);
  try
    if E^.Merged = nil then
    begin
      Result := BuildRaw(E);
      Result := ResolveAll(Result, Result);
      WriteBarrier;
      E^.Merged := Result;
    end;
    Result := E^.Merged;
  finally
    LeaveCriticalSection(Lock);
  end;
end;

function GetGlobal(const Key: string): TCLDRValue;
var
  T: TCLDRValue;
begin
  T := GlobalTree;
  ReadBarrier;
  if T = nil then
  begin
    if GlobalBlob = nil then
      raise ELocaleDataError.Create('no global CLDR data is linked (unit babel.cldr_global)');
    EnterCriticalSection(Lock);
    try
      if GlobalTree = nil then
      begin
        T := Decode(GlobalBlob, GlobalLen);
        WriteBarrier;
        GlobalTree := T;
      end;
      T := GlobalTree;
    finally
      LeaveCriticalSection(Lock);
    end;
  end;
  Result := T.Get(Key);
  if Result = nil then
    Result := EmptyMap;
end;

function EmptyCLDRMap: TCLDRValue;
begin
  Result := EmptyMap;
end;

procedure FreeNodes;
var
  I: Integer;
begin
  for I := 0 to NodeCount - 1 do
    Nodes[I].Free;
  Nodes := nil;
  NodeCount := 0;
end;

initialization
  InitCriticalSection(Lock);
  NoneNode := NewNode(ckNone);
  FalseNode := NewNode(ckBool);
  TrueNode := NewNode(ckBool);
  TrueNode.FInt := 1;
  EmptyMap := NewNode(ckMap);
finalization
  FreeNodes;
  DoneCriticalSection(Lock);
end.
